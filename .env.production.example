# Target Hostname
DOMAIN=cloudmeet.sequenceit.software

# Existing Traefik Settings on 69.62.75.165:
# 1. The Docker network your running Traefik container is attached to:
#    (On this server, the existing network is 'traefik-public')
TRAEFIK_NETWORK=traefik-public

# 2. Your Traefik HTTPS entrypoint (commonly: 'websecure' or 'https')
TRAEFIK_ENTRYPOINT=websecure

# 3. Your Traefik certificate resolver name (e.g. 'letsencrypt', 'myresolver', 'le', etc.)
TRAEFIK_CERT_RESOLVER=letsencrypt

# Backend API Configuration
