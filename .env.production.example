# ==============================================================================
# CloudMeet Production Environment Variables (Existing Traefik Setup)
# Copy this file to `.env` on the server and fill in every empty value.
# Never commit the real `.env` file.
# ==============================================================================

# Target Hostname
DOMAIN=admin.cloudnewsmeet.com

# Existing Traefik Settings on your server:
# 1. The Docker network your running Traefik container is attached to
TRAEFIK_NETWORK=

# 2. Your Traefik HTTPS entrypoint (commonly: 'websecure' or 'https')
TRAEFIK_ENTRYPOINT=

# 3. Your Traefik certificate resolver name (e.g. 'letsencrypt', 'myresolver', 'le')
TRAEFIK_CERT_RESOLVER=

# Backend API Configuration
PORT=5000
NODE_ENV=production
# Long random string, e.g. generate with: openssl rand -hex 32
JWT_SECRET=

# Tencent Cloud TRTC Master Credentials (from the Tencent Cloud Console)
TRTC_SDK_APP_ID=
TRTC_SECRET_KEY=

# Initial Super Administrator Credentials (for Admin Panel login)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Internal PostgreSQL Database Configuration
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
