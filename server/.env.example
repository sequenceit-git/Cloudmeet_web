# ==============================================================================
# CloudMeet Backend Server Environment Variables Template
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cloudmeet?schema=public"

# JWT Authentication Secret
JWT_SECRET="cloudmeet_jwt_super_secret_key_change_in_production"
JWT_EXPIRES_IN="7d"

# Tencent TRTC Cloud Credentials
# Replace with your Tencent Cloud Console SDKAppID (e.g. 1400XXXXXX)
TRTC_SDK_APP_ID=1400000000

# Tencent TRTC Master Secret Key (from Tencent Cloud Console)
TRTC_SECRET_KEY="your_tencent_trtc_secret_key_here"

# UserSig Token Validity Duration in seconds (86400 = 24 hours)
TRTC_EXPIRE_TIME=86400

# Default Administrator Credentials
ADMIN_EMAIL="admin@cloudmeet.cn"
ADMIN_PASSWORD="admin123456"
